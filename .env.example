# Copy to .env.local and fill in. Never commit .env.local.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → API (anon/publishable key is safe for the browser)
# Project URL only, e.g. https://abcd1234.supabase.co (no /rest/v1/ on the end)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resources assistant (server only). If ANTHROPIC_API_KEY is empty, the app
# uses a small local fallback so the demo still answers common questions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
USE_MOCK_AI=
